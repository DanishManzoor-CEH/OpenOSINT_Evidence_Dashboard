# Copy these entries into Streamlit Cloud Settings > Secrets.
# Replace placeholders with rotated keys. Never commit real keys.

OPENWEBNINJA_API_KEY = "YOUR_NEW_OPENWEBNINJA_KEY"
RAPIDAPI_KEY = "YOUR_NEW_RAPIDAPI_KEY"
RAPIDAPI_SOCIAL_LINKS_HOST = "social-links-search.p.rapidapi.com"

# Keep your existing application secrets too, if your app uses them:
# IPGEOLOCATION_API_KEY = "YOUR_IPGEOLOCATION_KEY"
# HIBP_API_KEY = "YOUR_HIBP_KEY"
# SERPAPI_API_KEY = "YOUR_SERPAPI_KEY"

# Optional: paid Twilio Lookup credentials
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""

# Optional: Have I Been Pwned subscription API key
HIBP_API_KEY = ""

# Optional: SerpAPI key for public web search results
SERPAPI_API_KEY = ""

# Optional: enable CrewAI analysis when your LLM credentials are configured
CREWAI_ENABLED = "false"

# Optional: model-provider key used by CrewAI
OPENAI_API_KEY = ""
